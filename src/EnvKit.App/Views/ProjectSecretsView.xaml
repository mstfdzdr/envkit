<UserControl x:Class="EnvKit.App.Views.ProjectSecretsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:EnvKit.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ProjectSecretsViewModel}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="300" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="300" />
    </Grid.ColumnDefinitions>

    <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Text="Project secrets" Style="{StaticResource PageTitle}" />

    <DockPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,0,0,12">
      <ui:Button DockPanel.Dock="Right" Content="Scan" Appearance="Primary" Icon="{ui:SymbolIcon FolderSearch24}"
                 Command="{Binding ScanCommand}" Margin="8,0,0,0" />
      <ui:Button DockPanel.Dock="Right" Content="Browse…" Icon="{ui:SymbolIcon FolderOpen24}" Click="OnBrowse" Margin="8,0,0,0" />
      <ui:TextBox Text="{Binding Folder, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Folder to scan, e.g. C:\dev"
                  FontFamily="Cascadia Mono, Consolas" AutomationProperties.Name="Folder">
        <ui:TextBox.InputBindings>
          <KeyBinding Key="Enter" Command="{Binding ScanCommand}" />
        </ui:TextBox.InputBindings>
      </ui:TextBox>
    </DockPanel>

    <DockPanel Grid.Row="2" Grid.Column="0">
      <TextBlock DockPanel.Dock="Top" Text="{Binding ScanSummary}" Style="{StaticResource Muted}" Margin="0,0,0,8" />
      <ListBox ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}" AutomationProperties.Name="Files"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="0,2">
              <TextBlock Text="{Binding Title}" FontFamily="Cascadia Mono, Consolas" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" FontSize="12" />
              <TextBlock Text="{Binding Warnings}" Style="{StaticResource Problem}" FontSize="12"
                         Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>

    <DockPanel Grid.Row="2" Grid.Column="1" Margin="16,0,0,0"
               Visibility="{Binding HasFile, Converter={StaticResource BoolToVisibility}}">
      <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" LastChildFill="False">
        <TextBlock DockPanel.Dock="Left" Text="{Binding SelectedFile.Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
        <ui:ToggleSwitch DockPanel.Dock="Right" Content="Show secret values" IsChecked="{Binding RevealSecrets}" />
      </DockPanel>
      <TextBlock DockPanel.Dock="Top" Text="{Binding Problems}" Style="{StaticResource Problem}" Margin="0,0,0,8" />
      <DataGrid ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry}" AutoGenerateColumns="False"
                IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="None"
                AutomationProperties.Name="Keys">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="2*" />
          <DataGridTextColumn Header="Value" Binding="{Binding DisplayValue}" Width="3*" />
        </DataGrid.Columns>
      </DataGrid>
    </DockPanel>

    <ui:Card Grid.Row="2" Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Top"
             Visibility="{Binding HasFile, Converter={StaticResource BoolToVisibility}}">
      <StackPanel>
        <TextBlock Text="Key" Margin="0,0,0,4" />
        <ui:TextBox Text="{Binding EditKey, UpdateSourceTrigger=PropertyChanged}" FontFamily="Cascadia Mono, Consolas"
                    AutomationProperties.Name="Key" />
        <TextBlock Text="Value (empty keeps a hidden one)" Margin="0,12,0,4" />
        <ui:TextBox Text="{Binding EditValue, UpdateSourceTrigger=PropertyChanged}" FontFamily="Cascadia Mono, Consolas"
                    TextWrapping="Wrap" MinHeight="64" AutomationProperties.Name="Value" />
        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
          <ui:Button Content="Review &amp; save" Appearance="Primary" Icon="{ui:SymbolIcon Save24}" Command="{Binding SaveCommand}" Margin="0,0,8,0" />
          <ui:Button Content="New" Icon="{ui:SymbolIcon Add24}" Command="{Binding NewEntryCommand}" Margin="0,0,8,0" />
          <ui:Button Icon="{ui:SymbolIcon Delete24}" Appearance="Danger" Command="{Binding DeleteCommand}" ToolTip="Remove key"
                     AutomationProperties.Name="Remove key" />
        </StackPanel>

        <StackPanel Margin="0,20,0,0" Visibility="{Binding IsDotEnv, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Text="Move to vault" FontWeight="SemiBold" />
          <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,8"
                     Text="Stores the value in the vault and leaves ${vault:NAME} in the file; envkit run --env-file fills it in." />
          <DockPanel>
            <ui:Button DockPanel.Dock="Right" Icon="{ui:SymbolIcon Vault24}" Content="Move…" Command="{Binding MoveToVaultCommand}" Margin="8,0,0,0" />
            <ui:TextBox Text="{Binding VaultName, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="vault name"
                        FontFamily="Cascadia Mono, Consolas" AutomationProperties.Name="Vault name" />
          </DockPanel>
        </StackPanel>
      </StackPanel>
    </ui:Card>
  </Grid>
</UserControl>
