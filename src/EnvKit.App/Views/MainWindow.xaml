<ui:FluentWindow x:Class="EnvKit.App.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:EnvKit.App.ViewModels"
             xmlns:l="clr-namespace:EnvKit.App.Localization"
                 xmlns:views="clr-namespace:EnvKit.App.Views"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance vm:MainViewModel}"
                 Title="EnvKit"
                 Icon="/Assets/EnvKit.ico"
                 Width="1180"
                 Height="760"
                 MinWidth="880"
                 MinHeight="560"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">
  <ui:FluentWindow.Resources>
    <DataTemplate DataType="{x:Type vm:PathViewModel}">
      <views:PathView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:VariablesViewModel}">
      <views:VariablesView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:CredentialsViewModel}">
      <views:CredentialsView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:ProfilesViewModel}">
      <views:ProfilesView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:VaultViewModel}">
      <views:VaultView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:ProjectSecretsViewModel}">
      <views:ProjectSecretsView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
      <views:SettingsView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:HistoryViewModel}">
      <views:HistoryView />
    </DataTemplate>
  </ui:FluentWindow.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <ui:TitleBar Grid.Row="0" Title="EnvKit">
      <ui:TitleBar.Icon>
        <ui:ImageIcon Source="/Assets/EnvKit-128.png" />
      </ui:TitleBar.Icon>
    </ui:TitleBar>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="200" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <ui:Button Grid.Column="0"
                 Margin="8,0,8,16"
                 HorizontalAlignment="Stretch"
                 VerticalAlignment="Bottom"
                 Appearance="Primary"
                 Icon="{ui:SymbolIcon ArrowClockwise24}"
                 Content="{Binding UpdateLabel}"
                 Command="{Binding RestartToUpdateCommand}"
                 Visibility="{Binding PendingUpdate, Converter={StaticResource NullToVisibility}}" />

      <ListBox Grid.Column="0"
               Margin="8,0,8,8"
               Background="Transparent"
               BorderThickness="0"
               ItemsSource="{Binding Pages}"
               SelectedItem="{Binding SelectedPage}"
               AutomationProperties.Name="{l:Tr Main_Navigation}">
        <!-- Windows 11 style: a subtle fill and an accent bar, readable in light and dark. -->
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Cursor" Value="Hand" />
            <!-- Shown for keyboard navigation only, not after a mouse click. -->
            <Setter Property="FocusVisualStyle">
              <Setter.Value>
                <Style>
                  <Setter Property="Control.Template">
                    <Setter.Value>
                      <ControlTemplate>
                        <Border CornerRadius="4" BorderThickness="2" BorderBrush="{DynamicResource FocusStrokeColorOuterBrush}" />
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </Setter.Value>
            </Setter>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                  <Border x:Name="Chrome" Background="Transparent" CornerRadius="4" Padding="8,0">
                    <Grid>
                      <Rectangle x:Name="Indicator" Width="3" Height="16" RadiusX="1.5" RadiusY="1.5" HorizontalAlignment="Left"
                                 Margin="-6,0,0,0" Fill="{DynamicResource AccentFillColorDefaultBrush}" Visibility="Collapsed" />
                      <ContentPresenter />
                    </Grid>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                      <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                      <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Orientation="Horizontal" Margin="4,9">
              <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="18" Margin="0,0,12,0" />
              <TextBlock Text="{Binding Title}" VerticalAlignment="Center" FontSize="14" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <Grid Grid.Column="1" Margin="8,0,24,16">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:InfoBar Grid.Row="0"
                    Margin="0,0,0,12"
                    Title="{Binding StatusTitle}"
                    Message="{Binding StatusMessage}"
                    Severity="{Binding StatusSeverity}"
                    IsOpen="{Binding IsStatusOpen, Mode=TwoWay}"
                    IsClosable="True" />

        <ContentControl Grid.Row="1" Content="{Binding SelectedPage}" Focusable="False" />
      </Grid>
    </Grid>

    <!-- Every write is confirmed here, whichever page started it. -->
    <Border Grid.Row="0"
            Grid.RowSpan="2"
            Background="#99000000"
            Visibility="{Binding Review, Converter={StaticResource NullToVisibility}}">
      <Border MaxWidth="760"
              MaxHeight="600"
              Margin="48"
              Padding="24"
              CornerRadius="8"
              Background="{DynamicResource ApplicationBackgroundBrush}"
              BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
              BorderThickness="1"
              DataContext="{Binding Review}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0" Text="{l:Tr Review_Title}" Style="{StaticResource PageTitle}" />
          <TextBlock Grid.Row="1" Text="{Binding Description}" Style="{StaticResource Muted}" Margin="0,0,0,12" />

          <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Changes}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Note, StringFormat='  ({0})'}">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding Note}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Lines}" Margin="12,4,0,0">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding Converter={StaticResource DiffLineText}}"
                                     Foreground="{Binding Kind, Converter={StaticResource DiffLineBrush}}"
                                     FontFamily="Cascadia Mono, Consolas"
                                     TextWrapping="Wrap" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <StackPanel Grid.Row="3" Margin="0,8,0,0">
            <TextBlock Style="{StaticResource Problem}"
                       Text="{l:Tr Review_Elevation}"
                       Visibility="{Binding RequiresElevation, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Style="{StaticResource Problem}" FontWeight="SemiBold"
                       Text="{l:Tr Review_Irreversible}"
                       Visibility="{Binding HasIrreversibleChanges, Converter={StaticResource BoolToVisibility}}" />
          </StackPanel>

          <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <ui:Button Content="{l:Tr Common_Cancel}" Command="{Binding CancelCommand}" Margin="0,0,8,0" MinWidth="96" />
            <ui:Button Content="{l:Tr Common_Apply}" Appearance="Primary" Icon="{ui:SymbolIcon Checkmark24}"
                       Command="{Binding ApplyCommand}" MinWidth="96" />
          </StackPanel>
        </Grid>
      </Border>
    </Border>
  </Grid>
</ui:FluentWindow>
