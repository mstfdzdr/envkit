<UserControl x:Class="EnvKit.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:EnvKit.App.ViewModels"
             xmlns:l="clr-namespace:EnvKit.App.Localization"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SettingsViewModel}">
  <UserControl.Resources>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,8" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>
    <Style x:Key="Link" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
      <Setter Property="Appearance" Value="Transparent" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="Margin" Value="0,0,8,0" />
    </Style>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="760" HorizontalAlignment="Left">
      <TextBlock Text="{l:Tr Page_Settings}" Style="{StaticResource PageTitle}" />

      <!-- Appearance and language -->
      <ui:Card Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="{l:Tr Settings_Appearance}" Style="{StaticResource SectionTitle}" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="140" />
              <ColumnDefinition Width="260" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="{l:Tr Settings_Theme}" VerticalAlignment="Center" />
            <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}"
                      ItemTemplate="{StaticResource EnumItem}" AutomationProperties.Name="{l:Tr Settings_Theme}" />
            <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Margin="0,6,0,16" Style="{StaticResource Muted}" FontSize="12"
                       Text="{l:Tr Settings_ThemeHint}" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="{l:Tr Settings_Language}" VerticalAlignment="Center" />
            <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}"
                      ItemTemplate="{StaticResource EnumItem}" AutomationProperties.Name="{l:Tr Settings_Language}" />
            <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Margin="0,6,0,0" Style="{StaticResource Muted}" FontSize="12"
                       Text="{l:Tr Settings_LanguageHint}" />
          </Grid>
        </StackPanel>
      </ui:Card>

      <!-- Data -->
      <ui:Card Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="{l:Tr Settings_Data}" Style="{StaticResource SectionTitle}" />
          <TextBlock Text="{l:Tr Settings_DataHint}" Style="{StaticResource Muted}" Margin="0,0,0,8" />
          <DockPanel>
            <ui:Button DockPanel.Dock="Right" Content="{l:Tr Settings_OpenFolder}" Icon="{ui:SymbolIcon FolderOpen24}"
                       Command="{Binding OpenDataFolderCommand}" Margin="8,0,0,0" />
            <TextBox IsReadOnly="True" Text="{Binding DataFolder, Mode=OneWay}" FontFamily="Cascadia Mono, Consolas"
                     AutomationProperties.Name="{l:Tr Settings_Data}" />
          </DockPanel>
        </StackPanel>
      </ui:Card>

      <!-- About -->
      <ui:Card>
        <StackPanel>
          <TextBlock Text="{l:Tr Settings_About}" Style="{StaticResource SectionTitle}" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image Grid.Column="0" Source="/Assets/EnvKit-128.png" Width="72" Height="72" Margin="0,0,16,0"
                   VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality" />
            <StackPanel Grid.Column="1">
              <TextBlock Text="EnvKit" FontSize="20" FontWeight="SemiBold" />
              <TextBlock Text="{Binding VersionText}" Style="{StaticResource Muted}" />
              <TextBlock Text="{l:Tr Settings_Tagline}" Margin="0,8,0,0" TextWrapping="Wrap" />
              <TextBlock Text="{l:Tr Settings_Author}" Margin="0,4,0,0" Style="{StaticResource Muted}" />
              <TextBlock Text="{l:Tr Settings_License}" Style="{StaticResource Muted}" />
            </StackPanel>
          </Grid>

          <WrapPanel Margin="0,16,0,0">
            <ui:Button Style="{StaticResource Link}" Icon="{ui:SymbolIcon Person24}" Content="{l:Tr Settings_Profile}"
                       Command="{Binding OpenLinkCommand}" CommandParameter="{Binding AuthorProfileUrl}"
                       ToolTip="{Binding AuthorProfileUrl}" />
            <ui:Button Style="{StaticResource Link}" Icon="{ui:SymbolIcon Code24}" Content="{l:Tr Settings_Repository}"
                       Command="{Binding OpenLinkCommand}" CommandParameter="{Binding RepositoryUrl}"
                       ToolTip="{Binding RepositoryUrl}" />
            <ui:Button Style="{StaticResource Link}" Icon="{ui:SymbolIcon Bug24}" Content="{l:Tr Settings_ReportIssue}"
                       Command="{Binding OpenLinkCommand}" CommandParameter="https://github.com/mstfdzdr/envkit/issues" />
          </WrapPanel>

          <DockPanel Margin="0,16,0,0" LastChildFill="True">
            <ui:Button DockPanel.Dock="Left" Content="{l:Tr Settings_CheckUpdates}" Icon="{ui:SymbolIcon ArrowSync24}"
                       Command="{Binding CheckForUpdatesCommand}" />
            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="{Binding UpdateStatus}" Style="{StaticResource Muted}" />
          </DockPanel>
        </StackPanel>
      </ui:Card>
    </StackPanel>
  </ScrollViewer>
</UserControl>
