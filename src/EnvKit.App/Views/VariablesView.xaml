<UserControl x:Class="EnvKit.App.Views.VariablesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:EnvKit.App.ViewModels"
             xmlns:l="clr-namespace:EnvKit.App.Localization"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:VariablesViewModel}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="380" />
    </Grid.ColumnDefinitions>

    <TextBlock Grid.Row="0" Text="{l:Tr Page_Variables}" Style="{StaticResource PageTitle}" />

    <DockPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,12">
      <ComboBox DockPanel.Dock="Left" MinWidth="140" ItemsSource="{Binding Scopes}" SelectedItem="{Binding Scope}"
                ItemTemplate="{StaticResource EnumItem}" AutomationProperties.Name="{l:Tr Common_Scope}" />
      <ui:Button DockPanel.Dock="Right" Content="{l:Tr Common_New}" Icon="{ui:SymbolIcon Add24}" Command="{Binding NewCommand}" Margin="8,0,0,0" />
      <ui:ToggleSwitch DockPanel.Dock="Right" Margin="12,0,4,0" Content="{l:Tr Common_ShowSecrets}"
                       IsChecked="{Binding RevealSecrets}" />
      <ui:TextBox Margin="8,0,0,0" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                  PlaceholderText="{l:Tr Vars_SearchPlaceholder}" Icon="{ui:SymbolIcon Search24}"
                  AutomationProperties.Name="{l:Tr Common_Search}" />
    </DockPanel>

    <DataGrid Grid.Row="2"
              Grid.Column="0"
              ItemsSource="{Binding Variables}"
              SelectedItem="{Binding Selected}"
              AutoGenerateColumns="False"
              IsReadOnly="True"
              SelectionMode="Single"
              HeadersVisibility="Column"
              GridLinesVisibility="None"
              AutomationProperties.Name="{l:Tr Page_Variables}">
      <DataGrid.Columns>
        <DataGridTextColumn Header="{l:Tr Common_Name}" Binding="{Binding Name}" Width="220" />
        <DataGridTextColumn Header="{l:Tr Common_Value}" Binding="{Binding DisplayValue}" Width="*" />
        <DataGridTextColumn Header="{l:Tr Vars_Kind}" Binding="{Binding Kind, Converter={StaticResource EnumText}}" Width="120" />
      </DataGrid.Columns>
    </DataGrid>

    <ui:Card Grid.Row="1" Grid.RowSpan="2" Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Top">
      <StackPanel>
        <TextBlock Text="{Binding EditorTitle}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />

        <TextBlock Text="{l:Tr Common_Name}" Margin="0,0,0,4" />
        <ui:TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsNew}"
                    AutomationProperties.Name="{l:Tr Common_Name}" />

        <TextBlock Text="{l:Tr Common_Value}" Margin="0,12,0,4" />
        <ui:TextBox Text="{Binding EditValue, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap"
                    MinHeight="96" MaxHeight="260" VerticalScrollBarVisibility="Auto"
                    FontFamily="Cascadia Mono, Consolas" AutomationProperties.Name="{l:Tr Common_Value}">
          <ui:TextBox.Style>
            <Style TargetType="ui:TextBox" BasedOn="{StaticResource {x:Type ui:TextBox}}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsValueHidden}" Value="True">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </ui:TextBox.Style>
        </ui:TextBox>
        <ui:Card Visibility="{Binding IsValueHidden, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Style="{StaticResource Muted}"
                     Text="{l:Tr Vars_Hidden}" />
        </ui:Card>

        <!-- Double underscores: a single one would be taken as an access key marker. -->
        <CheckBox Margin="0,12,0,0" IsChecked="{Binding EditExpandable}"
                  Content="{l:Tr Vars_Expand}" />
        <TextBlock Margin="0,8,0,0" Text="{Binding Preview}" Style="{StaticResource Muted}" />

        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
          <ui:Button Content="{l:Tr Common_ReviewSave}" Appearance="Primary" Icon="{ui:SymbolIcon Save24}"
                     Command="{Binding SaveCommand}" Margin="0,0,8,0" />
          <ui:Button Content="{l:Tr Common_Delete}" Appearance="Danger" Icon="{ui:SymbolIcon Delete24}" Command="{Binding DeleteCommand}" />
        </StackPanel>
      </StackPanel>
    </ui:Card>
  </Grid>
</UserControl>
