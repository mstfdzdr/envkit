<UserControl x:Class="EnvKit.App.Views.CredentialsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:EnvKit.App.ViewModels"
             xmlns:l="clr-namespace:EnvKit.App.Localization"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:CredentialsViewModel}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="320" />
    </Grid.ColumnDefinitions>

    <TextBlock Grid.Row="0" Text="{l:Tr Page_Credentials}" Style="{StaticResource PageTitle}" />

    <DockPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,12">
      <ComboBox DockPanel.Dock="Left" MinWidth="170" ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}"
                DisplayMemberPath="Label" AutomationProperties.Name="{l:Tr Creds_Tool}" />
      <ui:Button DockPanel.Dock="Right" Content="{l:Tr Common_New}" Icon="{ui:SymbolIcon Add24}" Command="{Binding NewCommand}" Margin="8,0,0,0" />
      <ui:TextBox Margin="8,0,0,0" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                  PlaceholderText="{l:Tr Creds_SearchPlaceholder}" Icon="{ui:SymbolIcon Search24}"
                  AutomationProperties.Name="{l:Tr Common_Search}" />
    </DockPanel>

    <DataGrid Grid.Row="2"
              Grid.Column="0"
              ItemsSource="{Binding Rows}"
              SelectedItem="{Binding Selected}"
              AutoGenerateColumns="False"
              CanUserAddRows="False"
              SelectionMode="Single"
              HeadersVisibility="Column"
              GridLinesVisibility="None"
              AutomationProperties.Name="{l:Tr Page_Credentials}">
      <DataGrid.Columns>
        <DataGridTemplateColumn Width="56">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}" MinWidth="0" Padding="0"
                        Margin="8,0,0,0" AutomationProperties.Name="{l:Tr Creds_SelectForDelete}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="{l:Tr Creds_Tool}" Binding="{Binding Group, Converter={StaticResource EnumText}}" Width="90" IsReadOnly="True" />
        <DataGridTextColumn Header="{l:Tr Creds_Target}" Binding="{Binding TargetName}" Width="3*" MinWidth="140" IsReadOnly="True" />
        <DataGridTextColumn Header="{l:Tr Creds_User}" Binding="{Binding UserName}" Width="2*" MinWidth="100" IsReadOnly="True" />
        <DataGridTextColumn Header="{l:Tr Creds_Type}" Binding="{Binding KindLabel}" Width="Auto" IsReadOnly="True" />
        <DataGridTextColumn Header="{l:Tr Creds_Written}" Binding="{Binding LastWritten, StringFormat='{}{0:yyyy-MM-dd}'}" Width="90" IsReadOnly="True" />
      </DataGrid.Columns>
    </DataGrid>

    <DockPanel Grid.Row="3" Grid.Column="0" Margin="0,12,0,0" LastChildFill="False">
      <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Text="{Binding Summary}" Style="{StaticResource Muted}" />
      <ui:Button DockPanel.Dock="Right" Content="{Binding DeleteLabel}"
                 Appearance="Danger" Icon="{ui:SymbolIcon Delete24}" Command="{Binding DeleteCommand}" Margin="8,0,0,0"
                 ToolTip="{l:Tr Creds_DeleteTip}" />
      <ui:Button DockPanel.Dock="Right" Content="{l:Tr Creds_Export}" Icon="{ui:SymbolIcon ArrowExportLtr24}" Click="OnExport"
                 ToolTip="{l:Tr Creds_ExportTip}" />
    </DockPanel>

    <ui:Card Grid.Row="1" Grid.RowSpan="3" Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Top">
      <StackPanel>
        <TextBlock Text="{Binding EditorTitle}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />

        <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,12"
                   Text="{l:Tr Creds_ReadOnly}"
                   Visibility="{Binding IsReadOnlyKind, Converter={StaticResource BoolToVisibility}}" />

        <TextBlock Text="{l:Tr Creds_Target}" Margin="0,0,0,4" />
        <ui:TextBox Text="{Binding EditTarget, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsNew}"
                    FontFamily="Cascadia Mono, Consolas" AutomationProperties.Name="{l:Tr Creds_Target}" />

        <StackPanel IsEnabled="{Binding IsReadOnlyKind, Converter={StaticResource InverseBool}}">
          <TextBlock Text="{l:Tr Creds_UserName}" Margin="0,12,0,4" />
          <ui:TextBox Text="{Binding EditUser, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{l:Tr Creds_UserName}" />

          <TextBlock Text="{Binding PasswordHint}" Margin="0,12,0,4" />
          <ui:PasswordBox Password="{Binding EditPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          AutomationProperties.Name="{l:Tr Creds_PasswordNew}" />

          <DockPanel Margin="0,8,0,0">
            <ui:Button DockPanel.Dock="Left" Content="{l:Tr Creds_ShowPassword}" Icon="{ui:SymbolIcon Eye24}"
                       Command="{Binding RevealPasswordCommand}" />
            <TextBox Margin="8,0,0,0" IsReadOnly="True" Text="{Binding RevealedSecret, Mode=OneWay}"
                     FontFamily="Cascadia Mono, Consolas" BorderThickness="0" Background="Transparent"
                     Visibility="{Binding RevealedSecret, Converter={StaticResource NullToVisibility}}"
                     AutomationProperties.Name="{l:Tr Creds_StoredPassword}" />
          </DockPanel>

          <TextBlock Text="{l:Tr Common_Comment}" Margin="0,12,0,4" />
          <ui:TextBox Text="{Binding EditComment, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{l:Tr Common_Comment}" />

          <TextBlock Text="{l:Tr Creds_Persistence}" Margin="0,12,0,4" />
          <ComboBox ItemsSource="{Binding Persistences}" SelectedItem="{Binding EditPersistence}"
                    ItemTemplate="{StaticResource EnumItem}" AutomationProperties.Name="{l:Tr Creds_Persistence}" />
        </StackPanel>

        <ui:Button Margin="0,16,0,0" Content="{l:Tr Common_ReviewSave}" Appearance="Primary" Icon="{ui:SymbolIcon Save24}"
                   Command="{Binding SaveCommand}" />
      </StackPanel>
    </ui:Card>
  </Grid>
</UserControl>
