<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(WindowsTfm)</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>EnvKit</AssemblyName>
    <RootNamespace>EnvKit.App</RootNamespace>
    <!-- Program.Main runs the installer hooks before WPF starts. -->
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <StartupObject>EnvKit.App.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Velopack" />
    <PackageReference Include="WPF-UI" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EnvKit.Core\EnvKit.Core.csproj" />
    <ProjectReference Include="..\EnvKit.Windows\EnvKit.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EnvKit.App.Tests" />
  </ItemGroup>

</Project>